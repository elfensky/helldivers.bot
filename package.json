{
    "name": "helldivers.bot",
    "version": "0.44.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build && serwist build",
        "start": "node .next/standalone/server.js",
        "format": "chokidar 'src/**/*.{js,jsx,ts,tsx}' -c 'npx prettier --write .'",
        "test": "vitest run && vitest run --config vitest.smoke.config.mjs",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "vitest run --config vitest.smoke.config.mjs"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.4.3",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "^16.2.2",
        "@prisma/adapter-pg": "^7.6.0",
        "@prisma/client": "^7.6.0",
        "@sentry/nextjs": "^10.47.0",
        "@serwist/next": "^9.5.7",
        "axios": "^1.14.0",
        "better-auth": "^1.5.6",
        "dotenv": "^17.3.1",
        "humanize-duration": "^3.33.2",
        "mermaid": "^11.14.0",
        "next": "^16.2.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-icons": "^5.6.0",
        "recharts": "^3.8.1",
        "remark-gfm": "^4.0.1",
        "serwist": "^9.5.7",
        "sonner": "^2.0.7",
        "web-push": "^3.6.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@serwist/cli": "^9.5.7",
        "@tailwindcss/postcss": "^4.2.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/coverage-v8": "^4.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "chokidar-cli": "^3.0.0",
        "esbuild": "^0.28.0",
        "jsdom": "^29.0.1",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "prisma": "^7.6.0",
        "tailwindcss": "^4.2.2",
        "vitest": "^4.1.2"
    },
    "overrides": {
        "prisma": {
            "hono": ">=4.12.7",
