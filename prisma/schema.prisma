// #region Initialize
datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client" //read https://www.prisma.io/docs/orm/prisma-schema/overview/generators#prisma-client-early-access
    output   = "../src/generated/prisma"
}

// #endregion

// #region Authentication & Authorization - BetterAuth
model Account {
    id                    String    @id @default(uuid(7))
    userId                String
    accountId             String
    providerId            String
    accessToken           String?   @db.Text
    refreshToken          String?   @db.Text
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    idToken               String?   @db.Text
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Session {
    id        String   @id @default(uuid(7))
    token     String   @unique
    userId    String
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Verification {
    id         String   @id @default(uuid(7))
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([identifier, value])
}

model User {
    id            String    @id @default(uuid(7))
    name          String?
    username      String?   @unique
    email         String?   @unique
    emailVerified Boolean   @default(false)
    image         String?
    role          String    @default("user")
    banned        Boolean   @default(false)
    accounts      Account[]
    sessions      Session[]
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    //custom relations
    settings Settings?
    apiKeys  ApiKey[]
}

// #endregion

// #region User
model Settings {
    // id String @id @default(uuid(7))
    userId   String @id @unique
    settings Json
    //relations
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
    id          String @id @default(uuid(7)) //also used as the key
    hash        String @unique //sha-256 hash of the key
    visible     String //last 4 characters of the actual key for display purposes.
    userId      String
    description String

    createdAt DateTime @default(now())
    enabled   Boolean  @default(true)
    //relations
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// #endregion

// #region HELLDIVERS
model h1_season {
    id                 String         @id @default(uuid(7))
    last_updated       DateTime?
    season             Int            @unique
    /// HD1's faction reveal order, indexed by enemy id (0=Bugs, 1=Cyborgs, 2=Illuminate).
    /// The VALUE is a 0-based rank: `0` is the faction the war started against, `1` and
    /// `2` are mid-war arrivals, `255` means never introduced this season. Readers must
    /// treat `0` as "present from day one" — not as "absent". Misreading it as 1-based
    /// caused a missing arrival beat in every season's archive narrative (v0.66.0).
    introduction_order Int[]          @default([])
    points_max         Int[]          @default([])
    season_duration    Int            @default(0)
    // relationships
    status             h1_status[]    @relation("OneSeasonToManyStatus")
    statistic          h1_statistic[] @relation("OneSeasonToManyStatistic")
    events             h1_event[]     @relation("OneSeasonToManyEvents")

    @@index([season])
    @@index([last_updated])
}

model h1_event {
    id               String @id @default(uuid(7))
    season           Int
    type             String
    event_id         Int
    start_time       Int
    end_time         Int
    region           Int
    enemy            Int
    points_max       Int
    points           Int
    status           String
    players_at_start Int?

    linked_season h1_season            @relation("OneSeasonToManyEvents", fields: [season], references: [season])
    progress      h1_event_progress[]  @relation("OneEventToManyProgress")

    @@unique([type, event_id])
    @@index([season, type])
    @@index([season, status])
    @@index([season, enemy])
}

model h1_status {
    id           String @id @default(uuid(7))
    season       Int
    enemy        Int    // 0=Bugs, 1=Cyborgs, 2=Illuminate
    bucket       Int    // floor(poll_time / BUCKET_SIZE) * BUCKET_SIZE — unique window start
    time         Int    // latest poll time within this bucket (drifts with each upsert)

    points       Int
    points_taken Int
    status       String // 'hidden' | 'active' | 'defeated'

    linked_season h1_season @relation("OneSeasonToManyStatus", fields: [season], references: [season])

    @@unique([season, enemy, bucket])
    @@index([season, bucket])
}

model h1_statistic {
    id                       String @id @default(uuid(7))
    season                   Int
    enemy                    Int
    bucket                   Int
    time                     Int

    // 11 per-faction timeseries fields (from API statistics[enemy]).
    // season_duration moved to h1_season as a scalar — per-season state,
    // not per-faction. Event counts (defend_events, successful_defend_events,
    // attack_events, successful_attack_events) are derivable from h1_event
    // with COUNT(*) WHERE type=... AND status=... AND season=X.
    players                  Int    @default(0)
    total_unique_players     Int    @default(0)
    missions                 Int    @default(0)
    successful_missions      Int    @default(0)
    total_mission_difficulty Int    @default(0)
    completed_planets        Int    @default(0)
    kills                    BigInt @default(0)
    deaths                   BigInt @default(0)
    accidentals              BigInt @default(0)
    shots                    BigInt @default(0)
    hits                     BigInt @default(0)

    linked_season h1_season @relation("OneSeasonToManyStatistic", fields: [season], references: [season])

    @@unique([season, enemy, bucket])
    @@index([season, bucket])
}

model h1_event_progress {
    id         String @id @default(uuid(7))
    type       String // 'attack' | 'defend'
    event_id   Int
    bucket     Int
    time       Int

    points     Int    // the progression signal — points_max is constant, lives on h1_event

    linked_event h1_event @relation("OneEventToManyProgress", fields: [type, event_id], references: [type, event_id])

    @@unique([type, event_id, bucket])
}

// #endregion

// #region PUSH NOTIFICATIONS
model push_subscription {
    id          Int      @id @default(autoincrement())
    endpoint    String   @unique
    keys_p256dh String
    keys_auth   String
    created_at  DateTime @default(now())

    @@index([endpoint])
}

// #endregion

// #region WORKER HEALTH
model worker_heartbeat {
    worker_type      String   @id
    last_beat        DateTime
    poll_duration_ms Int?
    last_error       String?
    started_at       DateTime
    updated_at       DateTime @updatedAt
}

// #endregion

// #region RATE LIMITING
// Fixed-window counters. One row per (key, route_group, window_start); the
// window_start is the unix-second start of the fixed window. Rows are
// incremented via atomic upsert and periodically purged once expired.
model api_rate_limit {
    key          String
    route_group  String
    window_start Int
    count        Int    @default(0)

    @@id([key, route_group, window_start])
    @@index([window_start])
}

// #endregion
