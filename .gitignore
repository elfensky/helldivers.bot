# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/

# next.js
/.next/
/out/

# production
/build

# Serwist — generated service worker (build artifact)
public/sw.js

# misc
.DS_Store
*.pem
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
*.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma
/src/generated/prisma
/.VSCodeCounter

# Serena (removed, prevent re-tracking)
.serena/cache/

# Claude
.claude
.worktrees
.superpowers
docs/superpowers/archive

# Local reference data (may contain secrets)
@references/

# Tool state
.claude-octopus/
.playwright-mcp/
.desloppify/

# Temporary verification screenshots
verify-*.png
scorecard.png

# Visual regression failure artifacts (the baselines themselves ARE committed)
**/__screenshots__/**/*-actual.png
**/__screenshots__/**/*-diff.png
.claude/skills/

# graphify graph (generated locally)
graphify-out/
