# LOCAL BUILD: docker build -f ./Dockerfile.migrate -t ghcr.io/elfensky/helldiversbot-migrate:staging .
FROM node:24-alpine
# Install tini to avoid zombie processes
RUN apk add --no-cache tini

# set working directory
WORKDIR /app
# Copy only what's needed for migrations
COPY package.json package-lock.json ./
COPY prisma ./prisma/
COPY prisma.config.mjs ./
# Install only prisma (not all dependencies) (used to be: npm ci --ignore-scripts)
RUN PRISMA_VERSION=$(node -p "require('./package.json').devDependencies?.prisma || require('./package.json').dependencies?.prisma") && \
    ADAPTER_PG_VERSION=$(node -p "require('./package.json').dependencies?.['@prisma/adapter-pg'] || ''") && \
    DOTENV_VERSION=$(node -p "require('./package.json').dependencies?.dotenv || ''") && \
    npm install prisma@$PRISMA_VERSION @prisma/client@$PRISMA_VERSION @prisma/adapter-pg@$ADAPTER_PG_VERSION dotenv@$DOTENV_VERSION && \
    POSTGRES_URL=postgresql://dummy npx prisma generate

# Run as non-root user (node user is built into node:*-alpine images)
RUN chown -R node:node /app
USER node

# Set tini as the init system
ENTRYPOINT ["/sbin/tini", "--"]
# Run migrations and exit
CMD sh -c "npx prisma migrate deploy && node --experimental-strip-types prisma/seed/seed.mjs"
