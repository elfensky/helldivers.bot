# LOCAL BUILD: docker build -f ./Dockerfile.migrate -t ghcr.io/elfensky/helldiversbot-migrate:staging .
FROM node:24-alpine
# Install tini to avoid zombie processes
RUN apk add --no-cache tini

# set working directory
WORKDIR /app
# Read versions from project package.json, but install against an empty one so
# npm doesn't pull in the entire Next.js app's dependency tree (~1.2 GB).
COPY package.json /tmp/project-package.json
COPY prisma ./prisma/
COPY prisma.config.mjs ./
RUN PRISMA_VERSION=$(node -p "require('/tmp/project-package.json').devDependencies?.prisma || require('/tmp/project-package.json').dependencies?.prisma") && \
    CLIENT_VERSION=$(node -p "require('/tmp/project-package.json').dependencies?.['@prisma/client']") && \
    ADAPTER_PG_VERSION=$(node -p "require('/tmp/project-package.json').dependencies?.['@prisma/adapter-pg']") && \
    DOTENV_VERSION=$(node -p "require('/tmp/project-package.json').dependencies?.dotenv") && \
    echo '{"name":"migrate","version":"1.0.0","private":true,"type":"module"}' > package.json && \
    npm install --no-audit --no-fund \
      prisma@$PRISMA_VERSION \
      @prisma/client@$CLIENT_VERSION \
      @prisma/adapter-pg@$ADAPTER_PG_VERSION \
      dotenv@$DOTENV_VERSION && \
    POSTGRES_URL=postgresql://dummy npx prisma generate && \
    rm /tmp/project-package.json && \
    npm cache clean --force && \
    rm -rf /root/.npm /tmp/*

# Run as non-root user. node can read root-owned files in /app (no writes
# needed for migrate or seed), so we skip the costly `chown -R` layer that
# duplicates all of /app into a second image layer.
USER node

# Set tini as the init system
ENTRYPOINT ["/sbin/tini", "--"]
# Run migrations and exit
CMD sh -c "npx prisma migrate deploy && node --experimental-strip-types prisma/seed/seed.mjs"
